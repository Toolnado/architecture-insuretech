  <diagram name="osago-to-be" id="insuretech-osago-to-be">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2280" pageHeight="2060" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="InsureTech — диаграмма контейнеров (C4): событийный обмен и онлайн-продажа ОСАГО" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;whiteSpace=wrap;fontSize=23;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="24" width="1700" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Новое в этой версии: сервис osago-aggregator со своим хранилищем, топики команд и предложений по ОСАГО, поток предложений в браузер через SSE и паттерны отказоустойчивости на внешних и внутренних вызовах." style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;whiteSpace=wrap;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="60" y="68" width="1700" height="42" as="geometry"/></mxCell>
        <mxCell id="boundary" value="InsureTech Prod  [Кластер Kubernetes]" style="rounded=1;arcSize=2;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#666666;strokeWidth=2;verticalAlign=bottom;align=left;spacingLeft=16;spacingBottom=10;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="270" width="1480" height="1300" as="geometry"/></mxCell>
        <mxCell id="person" value="&lt;b style=&quot;font-size:14px&quot;&gt;Клиент&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Заполняет заявку на ОСАГО и выбирает предложение&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#08427B;strokeColor=#052E56;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="partners" value="&lt;b style=&quot;font-size:14px&quot;&gt;Системы партнёров&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Встраивают страховые услуги в свои продукты&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#8A88A0;strokeColor=#6B6982;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="payment" value="&lt;b style=&quot;font-size:14px&quot;&gt;Платёжный сервис&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Приём оплаты за страховки&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#8A88A0;strokeColor=#6B6982;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="insurers" value="&lt;b style=&quot;font-size:14px&quot;&gt;Системы страховых компаний&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Сейчас 5, в планах 10.&lt;br&gt;Каталог и тарифы.&lt;br&gt;ОСАГО: создать заявку и получить предложение по заявке (REST)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#8A88A0;strokeColor=#6B6982;" vertex="1" parent="1"><mxGeometry x="1820" y="530" width="280" height="200" as="geometry"/></mxCell>
        <mxCell id="web" value="&lt;b style=&quot;font-size:14px&quot;&gt;InsureTech Web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: JavaScript, React]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Веб-приложение для клиентов&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#1BA1E2;strokeColor=#0E7DAF;" vertex="1" parent="1"><mxGeometry x="360" y="320" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="clientinfo" value="&lt;b style=&quot;font-size:14px&quot;&gt;client-info&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Kotlin, Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Учёт клиентских данных&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#1BA1E2;strokeColor=#0E7DAF;" vertex="1" parent="1"><mxGeometry x="760" y="320" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="clientdb" value="&lt;b style=&quot;font-size:14px&quot;&gt;client-info-db&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: PostgreSQL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Данные клиентов&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingTop=6;fillColor=#1BA1E2;strokeColor=#0E7DAF;" vertex="1" parent="1"><mxGeometry x="1120" y="325" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="coreapp" value="&lt;b style=&quot;font-size:14px&quot;&gt;core-app&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Kotlin, Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Оформление страховок и заявок на ОСАГО, витрина продуктов.&lt;br&gt;Реплику каталога обновляет из событий.&lt;br&gt;Событие об оформлении пишет в outbox той же транзакцией.&lt;br&gt;Держит SSE-соединения с браузерами&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#1BA1E2;strokeColor=#0E7DAF;" vertex="1" parent="1"><mxGeometry x="360" y="500" width="340" height="190" as="geometry"/></mxCell>
        <mxCell id="coredb" value="&lt;b style=&quot;font-size:14px&quot;&gt;core-db&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: PostgreSQL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Заявки, страховки, реплика каталога, полученные предложения, таблица outbox&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingTop=6;fillColor=#1BA1E2;strokeColor=#0E7DAF;" vertex="1" parent="1"><mxGeometry x="360" y="740" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="relay" value="&lt;b style=&quot;font-size:14px&quot;&gt;outbox-relay&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Debezium, Kafka Connect]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Читает журнал предзаписи и переносит записи outbox в топик&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#5B4FBE;strokeColor=#3F3590;" vertex="1" parent="1"><mxGeometry x="740" y="740" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="aggregator" value="&lt;b style=&quot;font-size:14px&quot;&gt;ins-product-aggregator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Kotlin, Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Отдельный адаптер на каждую страховую компанию: свой график, таймаут и предохранитель.&lt;br&gt;Публикует изменения каталога&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#1BA1E2;strokeColor=#0E7DAF;" vertex="1" parent="1"><mxGeometry x="1380" y="500" width="340" height="190" as="geometry"/></mxCell>
        <mxCell id="kafka" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#5B4FBE;strokeColor=#3F3590;" vertex="1" parent="1"><mxGeometry x="740" y="920" width="620" height="330" as="geometry"/></mxCell>
        <mxCell id="kafka_t" value="Kafka&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;[Container: Yandex Managed Service for Apache Kafka]&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="758" y="932" width="584" height="60" as="geometry"/></mxCell>
        <mxCell id="topic0" value="&lt;b&gt;insurance.products.v1&lt;/b&gt; — компактируемый, ключ insurer_id:product_id" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3F3590;fontFamily=Arial;fontSize=11;fontColor=#1A1440;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="998" width="560" height="42" as="geometry"/></mxCell>
        <mxCell id="topic1" value="&lt;b&gt;policies.issued.v1&lt;/b&gt; — ключ policy_id, длительное хранение для аудита" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3F3590;fontFamily=Arial;fontSize=11;fontColor=#1A1440;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="1048" width="560" height="42" as="geometry"/></mxCell>
        <mxCell id="topic2" value="&lt;b&gt;osago.quote-requests.v1&lt;/b&gt; — команды на подбор, ключ request_id" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3F3590;fontFamily=Arial;fontSize=11;fontColor=#1A1440;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="1098" width="560" height="42" as="geometry"/></mxCell>
        <mxCell id="topic3" value="&lt;b&gt;osago.offers.v1&lt;/b&gt; — предложения по мере поступления, ключ request_id" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3F3590;fontFamily=Arial;fontSize=11;fontColor=#1A1440;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="1148" width="560" height="42" as="geometry"/></mxCell>
        <mxCell id="topic4" value="&lt;b&gt;*.retry&lt;/b&gt; и &lt;b&gt;*.dlq&lt;/b&gt; — повторы и необработанные сообщения" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3F3590;fontFamily=Arial;fontSize=11;fontColor=#1A1440;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="1198" width="560" height="42" as="geometry"/></mxCell>
        <mxCell id="osago" value="&lt;b style=&quot;font-size:14px&quot;&gt;osago-aggregator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Kotlin, Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Отправляет заявку в каждую страховую компанию и опрашивает решения до дедлайна 60 с.&lt;br&gt;Каждое полученное предложение сразу публикует отдельным событием&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#5B4FBE;strokeColor=#3F3590;" vertex="1" parent="1"><mxGeometry x="1480" y="920" width="290" height="200" as="geometry"/></mxCell>
        <mxCell id="osagodb" value="&lt;b style=&quot;font-size:14px&quot;&gt;osago-aggregator-db&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: PostgreSQL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Состояние заявок, идентификаторы во внешних системах, план опроса, дедлайны&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingTop=6;fillColor=#5B4FBE;strokeColor=#3F3590;" vertex="1" parent="1"><mxGeometry x="1480" y="1140" width="290" height="110" as="geometry"/></mxCell>
        <mxCell id="settlement" value="&lt;b style=&quot;font-size:14px&quot;&gt;ins-comp-settlement&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Kotlin, Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Наполняет реестр оформленных страховок непрерывно из потока событий.&lt;br&gt;Раз в месяц отправляет реестр в страховые компании&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#1BA1E2;strokeColor=#0E7DAF;" vertex="1" parent="1"><mxGeometry x="740" y="1300" width="340" height="170" as="geometry"/></mxCell>
        <mxCell id="setdb" value="&lt;b style=&quot;font-size:14px&quot;&gt;ins-comp-settlement-db&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: PostgreSQL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Реестр страховок, условия взаиморасчётов, реплика каталога&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingTop=6;fillColor=#1BA1E2;strokeColor=#0E7DAF;" vertex="1" parent="1"><mxGeometry x="1140" y="1325" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="registry" value="&lt;b style=&quot;font-size:14px&quot;&gt;Schema Registry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Confluent Schema Registry]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Версионирование контрактов событий и проверка совместимости&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#5B4FBE;strokeColor=#3F3590;" vertex="1" parent="1"><mxGeometry x="1480" y="1300" width="290" height="130" as="geometry"/></mxCell>
