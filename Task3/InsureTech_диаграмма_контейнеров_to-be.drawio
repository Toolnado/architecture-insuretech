        <mxCell id="settlement" value="&lt;b style=&quot;font-size:14px&quot;&gt;ins-comp-settlement&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Kotlin, Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Наполняет реестр оформленных страховок непрерывно из потока событий.&lt;br&gt;Раз в месяц отправляет реестр в страховые компании&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#1BA1E2;strokeColor=#0E7DAF;" parent="1" vertex="1">
          <mxGeometry x="740" y="1220" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="setdb" value="&lt;b style=&quot;font-size:14px&quot;&gt;ins-comp-settlement-db&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: PostgreSQL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Реестр страховок, условия взаиморасчётов, реплика каталога&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingTop=6;fillColor=#1BA1E2;strokeColor=#0E7DAF;" parent="1" vertex="1">
