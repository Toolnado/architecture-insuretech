          <mxGeometry x="770" y="1032" width="620" height="46" as="geometry" />
        </mxCell>
        <mxCell id="topic3" value="&lt;b&gt;*.retry&lt;/b&gt; и &lt;b&gt;*.dlq&lt;/b&gt; — повторы и сообщения, которые не удалось обработать" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3F3590;fontFamily=Arial;fontSize=11;fontColor=#1A1440;align=left;spacingLeft=12;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="770" y="1086" width="620" height="40" as="geometry" />
