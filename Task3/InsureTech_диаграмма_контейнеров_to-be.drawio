        </mxCell>
        <mxCell id="topic1" value="&lt;b&gt;insurance.products.v1&lt;/b&gt; — компактируемый, ключ insurer_id:product_id" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3F3590;fontFamily=Arial;fontSize=11;fontColor=#1A1440;align=left;spacingLeft=12;verticalAlign=middle;" parent="1" vertex="1">
