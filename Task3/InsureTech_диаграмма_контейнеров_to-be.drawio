  <diagram name="containers-to-be" id="insuretech-containers-to-be">
    <mxGraphModel dx="912" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="InsureTech — диаграмма контейнеров (C4), целевое состояние: обмен данными через события" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;whiteSpace=wrap;fontSize=23;fontStyle=1;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="24" width="1600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Декомпозиция функциональности между сервисами не изменена. Изменён способ обмена: каталог продуктов и события об оформленных страховках публикуются в Kafka, синхронным остаётся только расчёт котировок ОСАГО." style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;whiteSpace=wrap;fontSize=12;fontColor=#444444;" parent="1" vertex="1">
          <mxGeometry x="60" y="68" width="1600" height="42" as="geometry" />
        </mxCell>
        <mxCell id="boundary" value="InsureTech Prod  [Кластер Kubernetes]" style="rounded=1;arcSize=2;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#666666;strokeWidth=2;verticalAlign=bottom;align=left;spacingLeft=16;spacingBottom=10;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#444444;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="300" y="270" width="1480" height="1300" as="geometry" />
        </mxCell>
        <mxCell id="person" value="&lt;b style=&quot;font-size:14px&quot;&gt;Клиент&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Подбирает и оформляет страховки&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#08427B;strokeColor=#052E56;" parent="1" vertex="1">
          <mxGeometry x="430" y="140" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="partners" value="&lt;b style=&quot;font-size:14px&quot;&gt;Системы партнёров&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Встраивают страховые услуги в свои продукты&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#8A88A0;strokeColor=#6B6982;" parent="1" vertex="1">
          <mxGeometry x="40" y="530" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="payment" value="&lt;b style=&quot;font-size:14px&quot;&gt;Платёжный сервис&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Приём оплаты за страховки&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#8A88A0;strokeColor=#6B6982;" parent="1" vertex="1">
          <mxGeometry x="40" y="740" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="insurers" value="&lt;b style=&quot;font-size:14px&quot;&gt;Системы страховых компаний&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Сейчас 5, в планах 10. API тарифов, андеррайтинга и оформления. REST / SOAP / GraphQL&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#8A88A0;strokeColor=#6B6982;" parent="1" vertex="1">
          <mxGeometry x="1820" y="530" width="280" height="180" as="geometry" />
        </mxCell>
        <mxCell id="web" value="&lt;b style=&quot;font-size:14px&quot;&gt;InsureTech Web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: JavaScript, React]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Веб-приложение для клиентов&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#1BA1E2;strokeColor=#0E7DAF;" parent="1" vertex="1">
          <mxGeometry x="360" y="320" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="clientinfo" value="&lt;b style=&quot;font-size:14px&quot;&gt;client-info&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Kotlin, Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Учёт клиентских данных&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#1BA1E2;strokeColor=#0E7DAF;" parent="1" vertex="1">
          <mxGeometry x="760" y="320" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="clientdb" value="&lt;b style=&quot;font-size:14px&quot;&gt;client-info-db&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: PostgreSQL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Данные клиентов&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingTop=6;fillColor=#1BA1E2;strokeColor=#0E7DAF;" parent="1" vertex="1">
          <mxGeometry x="1120" y="325" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="coreapp" value="&lt;b style=&quot;font-size:14px&quot;&gt;core-app&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Kotlin, Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Оформление страховок, витрина продуктов.&lt;br&gt;Локальную реплику каталога обновляет из событий, а не опросом.&lt;br&gt;Событие об оформлении пишет в таблицу outbox той же транзакцией&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#1BA1E2;strokeColor=#0E7DAF;" parent="1" vertex="1">
          <mxGeometry x="360" y="500" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="coredb" value="&lt;b style=&quot;font-size:14px&quot;&gt;core-db&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: PostgreSQL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Заявки и страховки, реплика каталога, таблица outbox&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingTop=6;fillColor=#1BA1E2;strokeColor=#0E7DAF;" parent="1" vertex="1">
          <mxGeometry x="360" y="720" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="relay" value="&lt;b style=&quot;font-size:14px&quot;&gt;outbox-relay&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Debezium, Kafka Connect]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Читает журнал предзаписи и переносит записи outbox в топик&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#5B4FBE;strokeColor=#3F3590;" parent="1" vertex="1">
          <mxGeometry x="740" y="720" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="aggregator" value="&lt;b style=&quot;font-size:14px&quot;&gt;ins-product-aggregator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Kotlin, Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Отдельный адаптер на каждую страховую компанию: свой график, таймаут и предохранитель.&lt;br&gt;Публикует изменения каталога.&lt;br&gt;Синхронный API оставлен только для котировок ОСАГО&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#1BA1E2;strokeColor=#0E7DAF;" parent="1" vertex="1">
          <mxGeometry x="1380" y="500" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="kafka" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#ffffff;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fillColor=#5B4FBE;strokeColor=#3F3590;" parent="1" vertex="1">
          <mxGeometry x="740" y="900" width="680" height="240" as="geometry" />
        </mxCell>
        <mxCell id="kafka_t" value="Kafka&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;[Container: Yandex Managed Service for Apache Kafka]&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#ffffff;align=center;" parent="1" vertex="1">
